PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Public/build-time application connection
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server/runtime application connection
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Real property sources
# Imóveis CAIXA is integrated directly from the official state CSV lists and needs no API key.
# Use these optional fields for another authorized normalized partner/API source.
PROPERTY_SEARCH_LIVE_URL=
PROPERTY_SEARCH_LIVE_TOKEN=

# Secure normalized import endpoint for authorized integration workers.
PROPERTY_IMPORT_WEBHOOK_SECRET=

# Protects the recurring synchronization of authorized XML/JSON property feeds.
PROPERTY_FEED_SYNC_SECRET=

# Public URL of the deployed MercadoImobi application. It is also used as a fallback
# to build OAuth callbacks, Evolution webhooks, voice callbacks and billing redirects.
MERCADOIMOBI_BASE_URL=

# Speed to Lead — signs tenant-specific lead ingestion URLs used by Meta/Google/LP automations.
# Keep this server-side only. If empty, the backend can derive the signature key from
# INTEGRATIONS_ENCRYPTION_KEY or SUPABASE_SERVICE_ROLE_KEY, but a dedicated random value is recommended.
LEAD_WEBHOOK_SECRET=

# AI assistant and public-source discovery — server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Protects the scheduled public-source discovery job endpoint.
PROPERTY_DISCOVERY_SECRET=

# Official Órulo API — requires credentials/contract supplied by Órulo.
ORULO_CLIENT_ID=
ORULO_CLIENT_SECRET=

# Google Maps Platform — server-side only. Enables Geocoding API + Places API (New)
# inside the Location Analysis module. Never expose this key in a VITE_* variable,
# repository file, browser bundle or client-side request.
GOOGLE_MAPS_API_KEY=

# Subscriber billing — server-side only.
# Create a recurring monthly Price in Stripe and configure its price_... ID here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# CCA document submission adapter — server-side only.
# Configure only an official/contracted CCA integration endpoint. When empty, the
# MercadoImobi stores the private dossier and keeps the direct-send button in prepared mode.
CCA_INTEGRATION_URL=
CCA_INTEGRATION_TOKEN=
# Optional read-only endpoint used only by the backend auditor. It must accept GET and
# return 2xx without creating a credit analysis or receiving customer documents.
CCA_HEALTHCHECK_URL=

# E-mail / CCA — server-side only.
# SMTP Hostinger is preferred when SMTP_PASSWORD is present. The password must exist only
# in the EasyPanel/runtime secrets and must never be committed to GitHub.
EMAIL_FROM=contato@rdmconsultoriaimobiliaria.com.br
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@rdmconsultoriaimobiliaria.com.br
SMTP_PASSWORD=
# Optional fallback provider. If SMTP is not configured, Resend continues supported.
RESEND_API_KEY=
# Optional default destination used on the CCA e-mail screen.
CCA_EMAIL_TO=

# Meta Omnichannel — Facebook Messenger + Instagram Direct for professional accounts.
# Create a Meta Business app and configure the callback as:
# https://YOUR_DOMAIN/api/public/oauth/meta
META_APP_ID=
META_APP_SECRET=
# Recommended independent random secret for signed OAuth state.
META_OAUTH_STATE_SECRET=
# Optional override. The application already has a safe default permission set.
META_OAUTH_SCOPES=

# Encrypts per-user integration credentials stored in the private Supabase Storage bucket.
# If empty, the backend derives encryption from SUPABASE_SERVICE_ROLE_KEY, but a dedicated
# random value is recommended in production.
INTEGRATIONS_ENCRYPTION_KEY=

# Click-to-call dialer — server-side only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Recommended API-key authentication in production (optional fallback to Account SID/Auth Token).
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Optional independent HMAC secret for the temporary Twilio bridge callback.
VOICE_WEBHOOK_SECRET=

# WhatsApp atendimento — server-side only; never expose these values in VITE_* variables.
# EVOLUTION_API_URL: public base URL of Evolution API, without a trailing slash.
# EVOLUTION_API_KEY: Evolution global/API key used by the backend to provision an isolated
# instance for each MercadoImobi tenant when that user clicks "Conectar meu WhatsApp".
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Optional legacy instance used only to preserve an existing administrator connection.
# New subscriber accounts receive automatically generated tenant-specific instances.
EVOLUTION_INSTANCE=
# Optional explicit callback URL. If empty, MERCADOIMOBI_BASE_URL + /api/public/hooks/whatsapp is used.
WHATSAPP_WEBHOOK_URL=
# Strong server-side secret sent by Evolution in the x-webhook-secret header.
WHATSAPP_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Operational parameters — optional. Safe defaults are applied when omitted.
# Change these in EasyPanel, then redeploy. Secrets never appear in the admin UI.
# -----------------------------------------------------------------------------
# Speed to Lead / roleta
SPEED_TO_LEAD_SLA_SECONDS=300
SPEED_TO_LEAD_METRICS_DAYS=7
SPEED_TO_LEAD_HISTORY_DAYS=30
LEAD_DISTRIBUTION_LOOKBACK_HOURS=24
SPEED_TO_LEAD_MAX_LEADS_QUERY=5000
SPEED_TO_LEAD_MAX_CONVERSATIONS_QUERY=3000
SPEED_TO_LEAD_MAX_MESSAGES_QUERY=10000
LEAD_DISTRIBUTION_MAX_SAMPLE=5000

# AI
AI_REQUEST_TIMEOUT_MS=30000
AI_HISTORY_MESSAGES=20
AI_DIAGNOSTIC_MAX_OUTPUT_TOKENS=8

# WhatsApp / Evolution
WHATSAPP_SEND_DELAY_MS=800
WHATSAPP_ATTACHMENT_MAX_MB=8
EVOLUTION_REQUEST_TIMEOUT_MS=25000

# Documents / CCA / e-mail
CCA_DOCUMENT_BUCKET=cca-documents
CCA_DOCUMENT_MAX_MB=12
CCA_SIGNED_URL_TTL_SECONDS=900
CCA_REQUEST_TIMEOUT_MS=30000
CCA_EMAIL_ATTACHMENT_MAX_MB=25
EMAIL_REQUEST_TIMEOUT_MS=45000

# External integrations
STRIPE_REQUEST_TIMEOUT_MS=20000
META_REQUEST_TIMEOUT_MS=25000
TWILIO_REQUEST_TIMEOUT_MS=25000
DIAGNOSTIC_REQUEST_TIMEOUT_MS=15000
VOICE_BRIDGE_TOKEN_MINUTES=5

# Optional CI/E2E credentials
TEST_USER=
TEST_PASS=
