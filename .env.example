PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Public/build-time application connection
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server/runtime application connection
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Real property sources
# Imóveis CAIXA is integrated directly from the official state CSV lists and needs no API key.
# Use these optional fields for another authorized normalized partner/API source.
PROPERTY_SEARCH_LIVE_URL=
PROPERTY_SEARCH_LIVE_TOKEN=

# Secure normalized import endpoint for authorized XML/API/integration workers.
PROPERTY_IMPORT_WEBHOOK_SECRET=

# AI assistant and public-source discovery — server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Protects the scheduled public-source discovery job endpoint.
PROPERTY_DISCOVERY_SECRET=

# WhatsApp atendimento — server-side only; never expose these values in VITE_* variables.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
WHATSAPP_WEBHOOK_SECRET=

# Optional CI/E2E credentials
TEST_USER=
TEST_PASS=
